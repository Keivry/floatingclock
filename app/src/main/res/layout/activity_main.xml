<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?android:attr/colorBackground">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Floating window switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/switch_floating_window"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary" />

        <Switch
            android:id="@+id/switchFloating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="end"
            style="@style/Widget.MaterialComponents.CompoundButton.Switch" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="?android:attr/listDivider" />

    <!-- Font selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/font_selection"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:textColor="?android:attr/textColorPrimary" />

    <RadioGroup
        android:id="@+id/rgFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbFontDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font_default"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbFontMonospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font_monospace"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbFontSerif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font_serif"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />
    </RadioGroup>

    <!-- Color selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_selection"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:textColor="?android:attr/textColorPrimary" />

    <RadioGroup
        android:id="@+id/rgColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbColorWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_white"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbColorRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_red"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbColorGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_green"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbColorBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_blue"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbColorYellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_yellow"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbColorCyan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_cyan"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbColorMagenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_magenta"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp" />
    </RadioGroup>

</LinearLayout>
